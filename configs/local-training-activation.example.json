  "activation_evidence_reference": "evidence:local-single-user-v1",
  "connect_timeout_seconds": 5,
  "statement_timeout_ms": 15000,
  "transaction_timeout_ms": 30000,
  "docker": {
    "container_name": "dohalm-local-postgres",
