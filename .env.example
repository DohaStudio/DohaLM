# Copy this file to .env and add local environment variables.
DOHALM_ENV=development
DOHALM_API_HOST=127.0.0.1
DOHALM_API_PORT=8000
DOHALM_API_PREFIX=/api/v1
DOHALM_CORS_ORIGINS=["http://localhost:3000"]
DOHALM_INFERENCE_PROVIDER=mock
DOHALM_REQUEST_TIMEOUT_SECONDS=60
DOHALM_STREAM_CHUNK_DELAY_MS=20
DOHALM_LOG_LEVEL=INFO
# Keep local model and adapter paths in .env only; never commit their values.
# DOHALM_MODEL_CACHE_ROOT=
# DOHALM_ADAPTER_ROOT=
# Base Qwen remains offline-only. Put an existing fixed snapshot path in local .env only.
DOHALM_BASE_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
DOHALM_BASE_MODEL_REVISION=989aa7980e4cf806f80c7fef2b1adb7bc71aa306
# DOHALM_BASE_MODEL_SNAPSHOT=
DOHALM_BASE_MODEL_QUANTIZATION=nf4
DOHALM_BASE_MODEL_DEVICE=cuda:0
DOHALM_MAX_CONCURRENT_GENERATIONS=1
DOHALM_MODEL_LOAD_TIMEOUT_SECONDS=300
DOHALM_GENERATION_TIMEOUT_SECONDS=120
DOHALM_MODEL_UNLOAD_ON_SHUTDOWN=true
DOHALM_MINIMUM_FREE_VRAM_MIB=5500
